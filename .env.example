# Copiar a .env para correr la UI en local (npm run dev). El .env no se commitea.
# Ninguna de estas variables es secreta.

# Auth0 (ver "Auth0" en Decisiones técnicas de SnippetSearcher). Los valores son
# las salidas de Pulumi en SnippetSearcher-infra/auth0 (npm run outputs).
VITE_AUTH0_DOMAIN=dev-eadjutr73y1lgdc5.us.auth0.com
VITE_AUTH0_CLIENT_ID=UOAJy3OakOnU6dtzoUakCbDeP3w1AbSX
VITE_AUTH0_AUDIENCE=https://snippetsearcher-api

# Opcional: a dónde le pasa los pedidos el proxy de Vite.
# SNIPPET_SERVICE_URL=http://localhost:8080
# PERMISSION_SERVICE_URL=http://localhost:8081

# Cypress (npm run cypress): usuario de prueba de Auth0 con el rol snippet-user.
# La contraseña es la de USUARIOS_PASSWORD en SnippetSearcher-infra/auth0/.env.
# AUTH0_USERNAME=ana@example.com
# AUTH0_PASSWORD=
